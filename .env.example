VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_API_BASE_URL=/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000

# Livestreaming (LiveKit Cloud: https://cloud.livekit.io — free tier is enough to start)
VITE_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Post photo storage (Cloudinary — free tier, no bandwidth surprise like S3-compatible egress)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Live streaming primary provider. Check the current plan limits in Agora Console.
VITE_AGORA_APP_ID=your-agora-app-id
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_WEBHOOK_SECRET=required-if-you-enable-the-agora-webhook

# 1-on-1 video call TURN relay. Open Relay advertises 20 GB/month at time of writing.
METERED_API_KEY=your-metered-api-key
METERED_DOMAIN=your-metered-subdomain

# Service role key — server-only, used by the Agora webhook to reconcile
# streams that ended without a clean stop. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
