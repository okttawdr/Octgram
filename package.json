{
  "name": "octgram-unified",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "dev:server": "node --watch server/index.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "start": "node server/index.mjs",
    "verify": "npm test && npm run build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "agora-rtc-sdk-ng": "^4.22.1",
    "agora-rtm-sdk": "^2.2.1",
    "agora-token": "^2.0.5",
    "livekit-client": "^2.9.7",
    "livekit-server-sdk": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.21.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "react-hook-form": "^7.49.2",
    "@hookform/resolvers": "^3.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
